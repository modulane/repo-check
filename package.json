{
  "name": "@modulane/repo-check",
  "version": "0.0.0-development",
  "description": "Check that a modulane repository still matches the reference setup in repo-template.",
  "license": "MIT",
  "type": "module",
  "bin": "bin/repo-check.js",
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --format=esm --target=node24 --legal-comments=eof --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/action.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "yarn format:check && yarn test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@modulane/prettier-config",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modulane/repo-check.git"
  },
  "homepage": "https://github.com/modulane/repo-check#readme",
  "bugs": {
    "url": "https://github.com/modulane/repo-check/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modulane/prettier-config": "^1.0.0",
    "esbuild": "0.25.12",
    "prettier": "3.9.10",
    "semantic-release": "^25.0.9"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "keywords": [
    "github-actions",
    "repository",
    "drift",
    "cli",
    "ci",
    "template"
  ]
}
